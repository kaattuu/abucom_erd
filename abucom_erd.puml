@startuml

entity merchant {
    * id INT
    --
    * nama VARCHAR
    alamat VARCHAR
    contact VARCHAR
    deskripsi TEXT
}

entity supplier {
    * id INT
    --
    * nama VARCHAR
    alamat VARCHAR
    contact VARCHAR
    deskripsi TEXT
}

entity goods {
    * id INT
    merchant_id INT <<FK>>
    --
    * sku VARCHAR
    --
    * nama VARCHAR
    * price DECIMAL
    stock INT
}

merchant ||--|{ goods

entity order {
    * id INT
    --
    merchant_id INT <<FK>>
    supplier_id INT <<FK>>
    --
    status VARCHAR
    tanggal DATE
}

merchant ||--|{ order
supplier ||--|{ order

entity order_detail {
    * id INT
    --
    order_id INT <<FK>>
    goods_id INT <<FK>>
    --
    quantity INT
    price DECIMAL
}

order ||--|| order_detail
goods ||--|{ order_detail

@enduml