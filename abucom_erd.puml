@startuml
!theme crt-green
' !theme crt-amber

entity user {
    id_user INT
    --
    name VARCHAR
}

entity merchant {
    id_merchant INT
    --
    user_id INT
    nama_toko VARCHAR
}

entity customer {
    id_customer INT
    --
    user_id INT
}

entity employee {
    id_employee INT
    --
    user_id INT
}

entity purchase {
    id_purchase INT
    --
    merchant_id INT
    supplier_id INT
    tanggal DATE
    status ENUM
}

entity purchase_detail {
    id_purchase_detail INT
    --
    purchase_id INT
    inventory_id INT
    quantity INT
    price DECIMAL
    total_price DECIMAL
}

entity inventory {
    id_inventory INT
    --
    merchant_id INT
    goods_id INT
    price DECIMAL
    stock INT
    stock_min INT
}

entity order {
    id_order INT
    --
    customer_id INT
    merchant_id INT
    tanggal DATE
    status ENUM
}

entity order_detail {
    id_order_detail INT
    --
    order_id INT
    inventory_id INT
    quantity INT
    price DECIMAL
    total_price DECIMAL
}

entity goods {
    id_goods INT
    --
    sku VARCHAR
    nama VARCHAR
}

entity inventory_log {
    id_log INT
    --
    inventory_id INT
    type ENUM
    quantity INT
    reference_id INT
    reference_type ENUM
    created_at TIMESTAMP
}


user |o--o| merchant
user |o--o| customer
user |o--o| employee

merchant |o--o{ purchase
merchant |o--o{ inventory
merchant |o--o{ order

customer |o--o{ order

employee |o--o| memantau

purchase |o--o| purchase_detail

inventory |o--o{ purchase_detail
inventory |o--o{ order_detail
inventory |o--o{ inventory_log
inventory }o--o| goods

order |o--o| order_detail




@enduml