@startuml

entity merchant {
    * id INT
    --
    * nama VARCHAR
    alamat VARCHAR
    contact VARCHAR
    deskripsi TEXT
}

entity supplier {
    * id INT
    --
    * nama VARCHAR
    alamat VARCHAR
    contact VARCHAR
    deskripsi TEXT
}

entity goods {
    * id INT
    merchant_id INT <<FK>>
    --
    * sku VARCHAR
    --
    * nama VARCHAR
    * price DECIMAL
    stock INT
}

merchant ||--|{ goods

entity order {
    * id INT
    --
    merchant_id INT <<FK>>
    supplier_id INT <<FK>>
    --
    status ENUM
    tanggal DATE
}

merchant ||--|{ order
supplier ||--|{ order

entity order_detail {
    * id INT
    --
    order_id INT <<FK>>
    goods_id INT <<FK>>
    --
    quantity INT
    price DECIMAL
}

order ||--|| order_detail
goods ||--|{ order_detail

entity customer {
    * id INT
    --
    nama VARCHAR
    contact VARCHAR
    alamat VARCHAR
    deskripsi TEXT
}

entity purchase {
    * id INT
    ---
    customer_id VARCHAR <<FK>>
    merchant_id VARCHAR <<FK>>
    --
    status ENUM
    tanggal DATE
}

entity purchase_detail {
    * id INT
    ---
    sale_id INT <<FK>>
    goods_id INT <<FK>>
    --
    quantity INT
    price DECIMAL
}

customer ||--|{ purchase
purchase }|--|| merchant
purchase ||--|| purchase_detail
purchase_detail }|-|| goods

@enduml